                },
                "method": {
                    "type": "string"
                },
                "error": {
                    "type": "string"
                }
            }
        },
        "execute_callback": "executeUnsubscribe",
        "permission_callback": "checkPermission",
        "meta": {
            "show_in_rest": true
        }
    },
    "datamachine/email-batch-unsubscribe": {
        "label": "Batch Unsubscribe",
        "description": "Unsubscribe from all mailing lists matching a search",
        "category": "datamachine-email",
        "input_schema": {
            "type": "object",
            "required": [
                "search"
            ],
            "properties": {
                "auth_ref": {
                    "type": "string",
                    "default": "email_imap:default",
                    "description": "Non-secret mailbox auth ref"
                },
                "search": {
                    "type": "string",
                    "description": "IMAP search criteria"
                },
                "folder": {
                    "type": "string",
                    "default": "INBOX"
                },
                "max": {
                    "type": "integer",
                    "default": 20,
                    "description": "Max unique senders to unsubscribe from (deduped by sender)"
                }
            }
        },
        "output_schema": {
            "type": "object",
            "properties": {
                "success": {
                    "type": "boolean"
                },
                "message": {
                    "type": "string"
                },
                "results": {
                    "type": "array"
                },
                "unsubscribed": {
                    "type": "integer"
                },
                "failed": {
                    "type": "integer"
                },
                "no_header": {
                    "type": "integer"
                }
            }
        },
        "execute_callback": "executeBatchUnsubscribe",
        "permission_callback": "checkPermission",
        "meta": {
            "show_in_rest": true
        }
    },
