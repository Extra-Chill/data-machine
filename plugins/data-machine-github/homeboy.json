{
  "auto_cleanup": false,
  "changelog_target": "docs/CHANGELOG.md",
  "extensions": {
    "wordpress": {
      "php": "8.2",
      "settings": {
        "validation_dependencies": [
          "../data-machine"
        ],
        "wordpress_test_paths": [
          "tests/github-files-smoke.php"
        ]
      }
    }
  },
  "id": "data-machine-github",
  "remote_path": "wp-content/plugins/data-machine-github",
  "version_targets": [
    {
      "file": "data-machine-github.php",
      "pattern": "(?m)^\\s*\\*?\\s*Version:\\s*([0-9.]+)"
    },
    {
      "file": "data-machine-github.php",
      "pattern": "DATAMACHINE_GITHUB_VERSION',\\s*'([0-9.]+)'"
    },
    {
      "file": "composer.json",
      "pattern": "\"version\":\\s*\"([0-9.]+)\""
    }
  ],
  "github": {
    "release_latest": false
  }
}
