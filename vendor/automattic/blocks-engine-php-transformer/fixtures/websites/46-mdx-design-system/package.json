{
  "name": "@halo-ui/docs",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "description": "Halo UI — the design system and component library for Lumen Labs. MDX-powered documentation.",
  "license": "MIT",
  "homepage": "https://halo.lumenlabs.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/lumen-labs/halo-ui.git",
    "directory": "apps/docs"
  },
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "astro check && tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx,astro,mdx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,astro,mdx,css}\"",
    "tokens:build": "style-dictionary build --config tokens/config.json"
  },
  "dependencies": {
    "@halo-ui/react": "workspace:^2.4.0",
    "@halo-ui/tokens": "workspace:^2.4.0",
    "astro": "^4.16.7",
    "@astrojs/mdx": "^3.1.9",
    "@astrojs/react": "^3.6.3",
    "@astrojs/sitemap": "^3.2.1",
    "@mdx-js/mdx": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^1.22.2",
    "rehype-slug": "^6.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "astro-expressive-code": "^0.38.3",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.1",
    "style-dictionary": "^4.2.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "packageManager": "pnpm@9.12.3"
}
