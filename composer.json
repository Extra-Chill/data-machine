{
	"name": "chubes/datamachine",
	"description": "WordPress plugin for automated data collection, AI processing, and multi-platform publishing",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.2",
		"wordpress/agents-api": "dev-main",
		"woocommerce/action-scheduler": "^3.9",
		"automattic/blocks-engine-php-transformer": "dev-trunk"
	},
	"autoload": {
		"psr-4": {
			"DataMachine\\Abilities\\": "inc/Abilities/",
			"DataMachine\\Api\\": "inc/Api/",
			"DataMachine\\Cli\\": "inc/Cli/",
			"DataMachine\\Core\\": "inc/Core/",
			"DataMachine\\Engine\\": "inc/Engine/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"DataMachine\\Tests\\": "tests/"
		},
		"files": [
			"tests/fixtures/phpunit-isolation.php"
		]
	},
	"scripts": {
		"lint": "homeboy extension exec wordpress -- \"$HOMEBOY_EXTENSION_PATH/vendor/bin/phpcs\" --standard='$HOMEBOY_EXTENSION_PATH/rulesets/homeboy-wordpress-project.xml' .",
		"lint-fix": "homeboy extension exec wordpress -- \"$HOMEBOY_EXTENSION_PATH/vendor/bin/phpcbf\" --standard='$HOMEBOY_EXTENSION_PATH/rulesets/homeboy-wordpress-project.xml' ."
	},
	"config": {
		"process-timeout": 0,
		"platform": {
			"php": "8.2.0"
		}
	},
	"repositories": [
		{
			"type": "package",
			"package": {
				"name": "automattic/blocks-engine-php-transformer",
				"version": "dev-trunk",
				"type": "library",
				"source": {
					"type": "git",
					"url": "https://github.com/Automattic/blocks-engine.git",
					"reference": "d8842683cb7928a0ae1f56878de93cf0bc8b7343"
				},
				"autoload": {
					"psr-4": {
						"Automattic\\BlocksEngine\\PhpTransformer\\": "php-transformer/src/"
					},
					"files": [
						"php-transformer/php-transformer.php"
					]
				},
				"require": {
					"php": ">=8.1",
					"league/commonmark": "^2.5",
					"league/html-to-markdown": "^5.1"
				}
			}
		},
		{
			"name": "agents-api",
			"type": "vcs",
			"url": "https://github.com/Automattic/agents-api"
		}
	]
}
